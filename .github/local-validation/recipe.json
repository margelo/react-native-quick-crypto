{
  "recipe_id": "rnqc-local-e2e-v1",
  "dependency_files": ["bun.lock", "package.json"],
  "toolchain_probes": [
    ["bun", "--version"],
    ["node", "--version"]
  ],
  "commands": [
    {
      "id": "ios-e2e",
      "argv": ["bun", "run", "e2e:ios"],
      "timeout_secs": 7200
    },
    {
      "id": "android-e2e",
      "argv": ["bun", "run", "e2e:android"],
      "timeout_secs": 7200
    }
  ]
}
