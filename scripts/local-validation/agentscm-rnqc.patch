+#[test]
+fn envelope_binds_bun_lock_and_package_manifest_digests() {
+    use sha2::{Digest, Sha256};
+
+    let f = ok_fixture();
+    let (sha, code) = f.attest();
+    assert_eq!(code, 0);
+    let envelope: Value =
+        serde_json::from_slice(&fs::read(f.state().join(format!("{sha}.envelope.json"))).unwrap())
+            .unwrap();
+    let digest = |name: &str| {
+        format!(
+            "{:x}",
+            Sha256::digest(fs::read(f.repo().join(name)).unwrap())
+        )
+    };
+    assert_eq!(
+        envelope["payload"]["dependencies"][0]["identity"],
+        "bun.lock"
+    );
+    assert_eq!(
+        envelope["payload"]["dependencies"][0]["state"]["revision"],
+        digest("bun.lock")
+    );
+    assert_eq!(
+        envelope["payload"]["dependencies"][1]["identity"],
+        "package.json"
+    );
+    assert_eq!(
+        envelope["payload"]["dependencies"][1]["state"]["revision"],
+        digest("package.json")
+    );
+}
